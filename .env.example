# Choose the primary provider: gemini or groq
LLM_PROVIDER=gemini

# Gemini (Google AI Studio key) — https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq (console.groq.com) — used as fast fallback and for optional Whisper STT
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_STT_MODEL=whisper-large-v3-turbo

# Model names change often: check the provider's model list and update here.
APP_ENV=dev
